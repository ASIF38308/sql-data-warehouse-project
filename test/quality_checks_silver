-- ====================================================================
-- silver.crm_cust_info
-- ====================================================================
-- Nulls or duplicate primary key — expect no results
SELECT cst_id, COUNT(*)
FROM datawarehouse_silver.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL;

-- Unwanted spaces — expect no results
SELECT cst_key FROM datawarehouse_silver.crm_cust_info WHERE cst_key != TRIM(cst_key);
SELECT cst_firstname FROM datawarehouse_silver.crm_cust_info WHERE cst_firstname != TRIM(cst_firstname);
SELECT cst_lastname FROM datawarehouse_silver.crm_cust_info WHERE cst_lastname != TRIM(cst_lastname);
SELECT cst_gndr FROM datawarehouse_silver.crm_cust_info WHERE cst_gndr != TRIM(cst_gndr);

-- Standardization check
SELECT DISTINCT cst_marital_status FROM datawarehouse_silver.crm_cust_info;
SELECT DISTINCT cst_gndr FROM datawarehouse_silver.crm_cust_info;

